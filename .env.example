# ============================================================
# AI Ops NeoBankingOperation Platform — CENTRAL RUNTIME CONFIG
# ============================================================
# This is the canonical configuration contract.
# Runtime values belong in .env / Kubernetes Secret/ConfigMap,
# never in Python modules, runbooks, Dockerfiles or manifests.

# -------------------- Application ----------------------------
APP_NAME=AI Ops NeoBankingOperation Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000

# -------------------- PostgreSQL -----------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -------------------- LLM / AI Gateway -----------------------
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4
LLM_TIMEOUT_SECONDS=60

# -------------------- Embedding Gateway ----------------------
# deterministic is for development/tests only. Production must use
# openai-compatible with an internal/offline embedding endpoint.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30

# -------------------- Logging / API --------------------------
LOG_LEVEL=INFO
LOG_JSON=False
INTERNAL_API_KEY=
# Role is server-controlled. Never accept role selection from request headers.
INTERNAL_API_ROLE=operator
API_RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["*"]

# -------------------- Zabbix -------------------------------
ZABBIX_URL=http://localhost:8080
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
ZABBIX_TIMEOUT_SECONDS=10

# -------------------- Elasticsearch -------------------------
ELASTICSEARCH_HOSTS=["http://localhost:9200"]
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=10

# -------------------- Prometheus ----------------------------
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=10

# -------------------- VM / SSH Execution Boundary -----------
SSH_ENABLED=False
SSH_USERNAME=
SSH_PRIVATE_KEY_PATH=
SSH_KNOWN_HOSTS=
SSH_STRICT_HOST_KEY_CHECKING=True
SSH_PORT=22
SSH_CONNECT_TIMEOUT=10
VM_CPU_RECOVERY_THRESHOLD=70

# -------------------- OIDC / SSO ----------------------------
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# -------------------- pgvector ------------------------------
PGVECTOR_EXPECTED_DIMENSION=1536
PGVECTOR_VALIDATE_ON_STARTUP=True

# -------------------- Offline Registry ----------------------
OFFLINE_IMAGE_REGISTRY=
IMAGE_PULL_POLICY=IfNotPresent

# NOTE: Do not commit real passwords, tokens, API keys or private URLs.
