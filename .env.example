# ============================================================
# AI Ops NeoBankingOperation Platform — CENTRAL RUNTIME CONFIG
# ============================================================
# Runtime values belong in .env / Kubernetes Secret/ConfigMap.

APP_NAME=AI Ops NeoBankingOperation Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4
LLM_TIMEOUT_SECONDS=60

# deterministic is development/test only. Production must use an internal/offline gateway.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
LOG_JSON=False
INTERNAL_API_KEY=
# Server-controlled role; request headers cannot select a role.
INTERNAL_API_ROLE=operator
API_RATE_LIMIT_PER_MINUTE=120
# Replace wildcard with explicit internal origins in production.
CORS_ORIGINS=["*"]
# Approval becomes unusable after this many seconds.
APPROVAL_TTL_SECONDS=3600

ZABBIX_URL=http://localhost:8080
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
ZABBIX_TIMEOUT_SECONDS=10

ELASTICSEARCH_HOSTS=["http://localhost:9200"]
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=10

PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=10

SSH_ENABLED=False
SSH_USERNAME=
SSH_PRIVATE_KEY_PATH=
SSH_KNOWN_HOSTS=
SSH_STRICT_HOST_KEY_CHECKING=True
SSH_PORT=22
SSH_CONNECT_TIMEOUT=10
VM_CPU_RECOVERY_THRESHOLD=70

OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

PGVECTOR_EXPECTED_DIMENSION=1536
PGVECTOR_VALIDATE_ON_STARTUP=True

OFFLINE_IMAGE_REGISTRY=
IMAGE_PULL_POLICY=IfNotPresent

# NOTE: Do not commit real passwords, tokens, API keys or private URLs.
