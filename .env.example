# ============================================================
# AI Ops NeoBankingOperation Platform — RUNTIME CONFIG TEMPLATE
# ============================================================
# Copy this file to .env for local development only.
# Production MUST inject environment-specific values through the deployment
# platform/secret manager. Never commit a populated .env.

APP_NAME=AI Ops NeoBankingOperation Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiops
ALEMBIC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aiops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_VALIDATE_MIGRATIONS_ON_STARTUP=True

# Development/test may use mock. For the documented Dotin General Chatbot use:
#   LLM_PROVIDER=dotin-general-chatbot
#   LLM_BASE_URL=https://aifa-chatbot.dev.dotin.ir
#   LLM_MODEL=assistance-model            # or developer-model
#   LLM_API_KEY=<Bearer token value only, without the "Bearer " prefix>
# The adapter targets POST /v1/chat/completions and emits x-request-id,
# x-session-id and x-user-id on every request. /chatbot reuses this same adapter;
# there is no second chatbot-specific LLM credential or endpoint.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=assistance-model
LLM_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=deterministic
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30
PGVECTOR_EXPECTED_DIMENSION=1536
PGVECTOR_VALIDATE_ON_STARTUP=True

# Operational Memory v2: hybrid vector+FTS retrieval and governed reuse feedback.
MEMORY_HYBRID_RETRIEVAL_ENABLED=True
MEMORY_RETRIEVAL_CANDIDATE_MULTIPLIER=4
MEMORY_RRF_K=60
MEMORY_MAX_EMBEDDING_TEXT_CHARS=12000
MEMORY_REUSE_FEEDBACK_ENABLED=True
MEMORY_STALE_AFTER_DAYS=90

# Governed Knowledge RAG. Cognia is the only RAG provider in every environment.
# A clean development/test checkout may leave Cognia connection values empty;
# retrieval then reports a typed Cognia misconfiguration instead of falling back.
# COGNIA_BASE_URL supports both http:// and https://. HTTPS certificate
# validation is intentionally disabled by the project transport policy.
COGNIA_BASE_URL=
COGNIA_CLIENT_ID=
COGNIA_CLIENT_SECRET=
# Numeric Cognia Client Application identity used by Scope/Search. This is
# distinct from the opaque/string clientId credential used for machine auth.
COGNIA_CLIENT_APPLICATION_ID=
COGNIA_KNOWLEDGE_BASE_IDS=[]
COGNIA_CONTEXT_PROFILE_ID=
COGNIA_TIMEOUT_SECONDS=15

AGENT_LLM_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1200
AGENT_MAX_EVIDENCE_ITEMS=40
AGENT_MIN_EVIDENCE_ITEMS=1
AGENT_MIN_EVIDENCE_COVERAGE=0.5
AGENT_LOW_CONFIDENCE_THRESHOLD=0.55
AGENT_MIN_CONSENSUS_SCORE=0.6
AGENT_SOURCE_QUALITY_WEIGHTS={"zabbix":0.95,"elasticsearch":0.9,"prometheus":0.95,"kubernetes_api":0.95,"vm_mcp":0.95,"unknown":0.5}
AGENT_MAX_RECOMMENDATIONS=5
AGENT_MAX_HYPOTHESES=4
AGENT_MAX_AUXILIARY_CONTEXT_ITEMS=5
AGENT_ENABLED_AGENTS=["application","infrastructure","kubernetes","security","vm","database","network","storage","identity","change","dependency","messaging","recovery"]
AGENT_MAX_PARALLELISM=5
AGENT_MAX_EVIDENCE_ROUNDS=2
# Optional LLM-led investigation remains disabled until controlled rollout.
# Confirmed nginx syntax faults still get a deterministic read-only MCP preview;
# neither path can apply configuration files or authorize service actions.
AIOPS_DYNAMIC_INVESTIGATION_ENABLED=false
# Explicitly enable complete-file LLM repair only for a trusted gateway.
AIOPS_FULL_CONFIG_LLM_ENABLED=false
# Complete-file candidates use a purpose-separated key derived from MCP_BEARER_TOKEN.
# Optional private persistent vault location on the VM MCP host (NOT the remote VM).
# Windows example: set in your local .env, unquoted; backslashes work unchanged:
# AIOPS_CONFIG_CANDIDATE_DIRECTORY=D:\data\tempaips
# Leave empty to use Windows %ProgramData%\AIOps\config-candidates
# or Linux /var/lib/aiops/config-candidates. No extra encryption key is needed.
AIOPS_CONFIG_CANDIDATE_DIRECTORY=

AGENT_MAX_DYNAMIC_EVIDENCE_TYPES=5
AGENT_INITIAL_EVIDENCE_WINDOW_SECONDS=900
AGENT_REFRESH_EVIDENCE_WINDOW_SECONDS=600
AGENT_TIMEOUT_SECONDS=45
AGENT_STRUCTURED_REPAIR_ATTEMPTS=1
AGENT_STALE_EVIDENCE_SECONDS=1800
AGENT_DISAGREEMENT_CONFIDENCE_FACTOR=0.75
AGENT_MISSING_EVIDENCE_CONFIDENCE_FACTOR=0.85
AGENT_CONFLICT_CONFIDENCE_PENALTY=0.2
A2A_TIMEOUT_SECONDS=15
A2A_ALLOWED_TARGETS=[]

SIGNAL_CORRELATION_ENABLED=True
SIGNAL_CORRELATION_WINDOW_SECONDS=120
SIGNAL_CORRELATION_CANDIDATE_LIMIT=25

# -------------------- Logging ---------------------------------
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=True
LOG_TEXT_FILE_ENABLED=True
LOG_JSON_FILE_ENABLED=True
LOG_DIR=logs
LOG_TEXT_FILE=aiops.log
LOG_JSON_FILE=aiops.json.log
LOG_ROTATION_MODE=size
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_ROTATION_WHEN=midnight
LOG_ROTATION_INTERVAL=1
LOG_UTC=True
LOG_HTTP_BODY_ENABLED=True
LOG_HTTP_BODY_MAX_BYTES=8192

# /chatbot authenticates with the existing API boundary. The browser sends
# X-API-Key and keeps it only in sessionStorage; this value is never a chatbot
# history/LLM setting. INTERNAL_API_ROLE remains the server-side role mapped to
# the single internal API key; OIDC can supply per-user roles instead.
INTERNAL_API_KEY=
INTERNAL_API_ROLE=operator
API_RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_STRICT_REQUESTS=20
RATE_LIMIT_LOOSE_REQUESTS=500
RATE_LIMIT_WINDOW_SECONDS=60
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0
CORS_ORIGINS=["*"]
APPROVAL_TTL_SECONDS=3600

# -------------------- Canonical MCP external-tool transport ---
MCP_PROTOCOL_VERSION=2025-03-26
# One fixed Control-Plane API key for internal MCP reads and writes.
# Set the same secret value on the Control Plane and its internal MCP server.
# Keep the populated value out of git and inject it through the environment or
# deployment secret store in operational and production environments.
# Also used (via an HMAC-derived, purpose-specific key) to authenticate
# short-lived, hash-bound configuration APPLY approval claims.
# Use a random secret of >=32 UTF-8 bytes, identical on API and VM MCP.
# The same token is the shared trust root for MCP authentication and signing.
# No AIOPS_CONFIG_APPLY_SIGNING_SECRET variable is needed.
MCP_BEARER_TOKEN=
# Legacy compatibility field; internal VM/Kubernetes MCP no longer uses it.
MCP_WRITE_BEARER_TOKEN=
MCP_CLIENT_CERT_PATH=
MCP_CLIENT_KEY_PATH=
MCP_TIMEOUT_SECONDS=15
MCP_SERVER_PROVIDER=elasticsearch
MCP_SERVER_REQUIRE_AUTH=True

# Zabbix is MCP-only: AIOps connects to initMAX/zabbix-mcp-server and never
# connects directly to the Zabbix API. ZABBIX_MCP_HOST_HEADER is optional and
# should only be set when the MCP reverse proxy validates a specific Host value.
# /chatbot uses this same allowlisted read boundary for Zabbix problem evidence.
ZABBIX_MCP_URL=http://localhost:9101/mcp
ZABBIX_MCP_SERVER_NAME=
ZABBIX_MCP_AUTH_HEADER=
ZABBIX_MCP_HOST_HEADER=

# Official Jenkins mcp-server plugin. Use the Streamable HTTP endpoint exactly:
#   https://jenkins.example/mcp-server/mcp
# Authentication is a complete HTTP Basic header built from username:API-token.
# Keep read and write Jenkins identities separate. Writes are disabled by default
# and additionally require the AIOps durable Approval/binding path.
JENKINS_MCP_URL=
JENKINS_MCP_PROTOCOL_VERSION=2025-06-18
JENKINS_MCP_AUTH_HEADER=
JENKINS_MCP_WRITE_AUTH_HEADER=
JENKINS_MCP_EXPECTED_IDENTITY=
# Optional Jenkins root URL for deployments enforcing MCP Origin matching.
JENKINS_MCP_ORIGIN=
JENKINS_MCP_ENABLE_WRITES=False

ELASTIC_STACK_VERSION=9.3.2
ELASTICSEARCH_MCP_URL=http://localhost:5601/api/agent_builder/mcp
# Elastic's documented Agent Builder MCP initialize contract currently uses
# 2024-11-05. Keep this provider-specific instead of inheriting the generic MCP version.
ELASTICSEARCH_MCP_PROTOCOL_VERSION=2024-11-05
# Authentication option 1: complete Authorization value (ApiKey/Bearer/Basic).
# Authentication option 2: Kibana username/password. The client builds the
# HTTP Basic header at runtime, so you do not need to Base64-encode credentials.
# Configure exactly one option. Never commit populated credentials.
# The generic MCP_BEARER_TOKEN is intentionally never forwarded to Kibana.
ELASTICSEARCH_MCP_AUTH_HEADER=
ELASTICSEARCH_MCP_USERNAME=
ELASTICSEARCH_MCP_PASSWORD=
# MCP tool namespace, NOT the Kibana Space path. A Kibana Space called
# "mcp" belongs in ELASTICSEARCH_MCP_URL as /s/mcp/api/agent_builder/mcp,
# while this namespace remains platform.core for the ES|QL tool.
ELASTIC_AGENT_BUILDER_MCP_NAMESPACES=["platform.core"]
# Set the real app index in the DEPLOYED .env; e.g. for the GFP environment:
# ELASTIC_AGENT_BUILDER_INDEX_PATTERN=1m-digitaloperation-gfpapi-*
ELASTIC_AGENT_BUILDER_INDEX_PATTERN=logs-*
# Optional confirmed service-to-log-label aliases (not VM target mappings).
# Example after independently validating the relationship:
# ELASTIC_SERVICE_DISCOVERY_ALIASES={"gfpapi":["GFP_Backend"]}
ELASTIC_SERVICE_DISCOVERY_ALIASES={}
# Elastic ML Anomaly Detection webhook policy. Interim results are ignored by
# default because their score can change when the bucket is finalized.
ELASTIC_ANOMALY_ACCEPT_INTERIM=False
ELASTIC_ANOMALY_CONTEXT_LOOKBACK_SECONDS=900
ELASTIC_ANOMALY_CONTEXT_LOOKAHEAD_SECONDS=300
# Fallback when the alert does not contain an explicit service or service
# influencer/tag. Example: {"payment-latency-job":"payment-api"}
ELASTIC_ANOMALY_JOB_SERVICE_MAP={}

# Official prometheus/prometheus-mcp Streamable HTTP endpoint.
# v0.18.x uses MCP protocol 2025-11-25 as its latest supported version.
PROMETHEUS_MCP_URL=http://localhost:9103/mcp
PROMETHEUS_MCP_PROTOCOL_VERSION=2025-11-25
PROMETHEUS_MCP_SERVICE_LABEL=service
# Alertmanager webhook triggers are enriched around startsAt. The same read-only
# evidence collectors are used, including Prometheus MCP range queries.
PROMETHEUS_ALERT_CONTEXT_LOOKBACK_SECONDS=900
PROMETHEUS_ALERT_CONTEXT_LOOKAHEAD_SECONDS=300
# IMPORTANT: the official server forwards Authorization to Prometheus.
# Leave empty unless that exact backend credential is intentionally required.
PROMETHEUS_MCP_AUTH_HEADER=

# Operations Copilot VM/Kubernetes questions and actions keep the same MCP-only
# trust boundary. Leave unset when that provider is unavailable; production
# verification of real reads/writes remains environment acceptance.
# IMPORTANT: VM_MCP_URL must point to a dedicated apps.mcp_server.main process
# started with MCP_SERVER_PROVIDER=vm. Do not reuse an Elasticsearch MCP process
# (for example a local provider=elasticsearch instance on port 9104). A typical
# local split is Elasticsearch MCP on 9104 and VM MCP on 9105.
KUBERNETES_MCP_URL=
VM_MCP_URL=

# Select SSH VM MCP (legacy, unchanged) or installed on-host VM agents.
# In agent mode, VM_MCP_URL is not used. Every destination must have a
# statically configured agent endpoint: no discovery from alerts/LLM content.
# ssh=legacy VM MCP over SSH; agent=inbound HTTPS; agent_pull=Puppet-style reverse WSS
VM_EXECUTION_BACKEND=ssh

VM_AGENT_ENDPOINTS={}
# API: per-target bearer identities; configure as secret JSON via secret manager.
VM_AGENT_TOKENS={}
# API only: password provided in clear in this protected .env; delivered once
# over authenticated WSS after Agent identity verification, never logged.
VM_AGENT_EXECUTION_CREDENTIALS={}

# Destination agent: only its own private bearer, not the central MCP token.
VM_AGENT_BEARER_TOKEN=
# Optional PEM trust bundle for HTTPS endpoints signed by an internal CA.
# TLS hostname/certificate verification is mandatory for agent mode.
VM_AGENT_CA_BUNDLE_PATH=
# Outbound WSS verifies Backend certificate and hostname by default.
VM_AGENT_TLS_VERIFY=True
# Outbound agent initiates WSS to the API; never append a target to this URL.
VM_AGENT_CONTROL_PLANE_WS_URL=
VM_AGENT_CONNECTION_MODE=inbound

# Configure the following only in each installed agent's environment:
# MCP_SERVER_PROVIDER=vm_agent
# SSH_ENABLED=False
# VM_AGENT_TARGET=10.100.6.199
# VM_AGENT_ALLOWED_SERVICES=["nginx","gfpapi"]
VM_AGENT_EXEC_USERNAME=aiops-agent
VM_AGENT_TARGET=
VM_AGENT_ALLOWED_SERVICES=[]

# -------------------- MCP server-side direct adapters ---------
# Zabbix is intentionally excluded; its only supported boundary is initMAX MCP.
# Kubernetes direct API settings belong to the Kubernetes MCP server process,
# never the production Control Plane process (which must use KUBERNETES_MCP_URL).
ELASTICSEARCH_HOSTS=["http://localhost:9200"]
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=10
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SECONDS=10
KUBERNETES_API_URL=
KUBERNETES_TOKEN=
KUBERNETES_TOKEN_FILE=
KUBERNETES_NAMESPACE=default
KUBERNETES_TIMEOUT_SECONDS=10
KUBERNETES_LOG_TAIL_LINES=100
SSH_ENABLED=False
# VM MCP SSH authentication. key preserves the existing behavior. password uses
# AsyncSSH and keeps the password out of process command lines. In production,
# SSH_PASSWORD must come from a secret manager/environment injection, never git.
SSH_AUTH_MODE=key
SSH_USERNAME=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_KNOWN_HOSTS=
SSH_STRICT_HOST_KEY_CHECKING=True
SSH_PORT=22
SSH_CONNECT_TIMEOUT=10
SSH_ALLOWED_TARGETS=[]
SSH_ALLOWED_SERVICES=[]
VM_CPU_RECOVERY_THRESHOLD=70

OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OFFLINE_IMAGE_REGISTRY=
IMAGE_PULL_POLICY=IfNotPresent

