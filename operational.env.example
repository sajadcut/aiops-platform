# Copy to a local untracked file and fill with staging-only values.
AIOPS_TEST_ENV=staging
ALLOW_DESTRUCTIVE_TESTS=false
AIOPS_TEST_AUTO_APPROVE=false

# AIOps API under test
AIOPS_BASE_URL=https://aiops.staging.example
AIOPS_API_KEY=
AIOPS_BEARER_TOKEN=
AIOPS_TLS_VERIFY=true

# Dedicated staging-only typed failure injector. Never point this at production.
AIOPS_FAULT_INJECTOR_URL=https://fault-injector.staging.example
AIOPS_FAULT_INJECTOR_TOKEN=
AIOPS_TEST_ALLOWED_TARGETS=
AIOPS_TEST_ALLOWED_FAULT_ACTIONS=

# Monitoring APIs used to prove that the injected failure was actually observed.
PROMETHEUS_URL=https://prometheus.staging.example
ELASTICSEARCH_URL=https://elasticsearch.staging.example
ELASTICSEARCH_API_KEY=
ZABBIX_API_URL=https://zabbix.staging.example/api_jsonrpc.php
ZABBIX_API_TOKEN=

# Common scenario targets
AIOPS_TEST_SERVICE=payments
AIOPS_TEST_VM_HOST=vm-staging-01
AIOPS_TEST_VM_SERVICE=payments.service
AIOPS_TEST_MOUNT=/var/lib/aiops-oat
AIOPS_TEST_POSTGRES=postgres-staging
AIOPS_TEST_K8S_NAMESPACE=aiops-oat
AIOPS_TEST_K8S_WORKLOAD=deployment/payments
AIOPS_TEST_NETWORK_TARGET=payments.staging.example
AIOPS_TEST_DEPENDENCY=redis-staging
AIOPS_TEST_ELASTICSEARCH_TARGET=elasticsearch-staging
AIOPS_TEST_PROMETHEUS_TARGET=prometheus-staging
AIOPS_TEST_ZABBIX_TARGET=zabbix-staging
AIOPS_TEST_IDENTITY_TARGET=keycloak-staging
AIOPS_TEST_TLS_TARGET=https://payments.staging.example/health
AIOPS_TEST_MESSAGING_TARGET=kafka-staging
AIOPS_TEST_BACKUP_TARGET=postgres-backup-staging
AIOPS_TEST_MCP_TARGET=vm-mcp-staging
AIOPS_TEST_LLM_TARGET=llm-proxy-staging
AIOPS_TEST_SECOND_TARGET=orders

# Site-specific PromQL / ELK expressions for scenarios whose metric names are deployment-specific.
AIOPS_TEST_MESSAGING_LAG_PROMQL=
AIOPS_TEST_BACKUP_FAILURE_PROMQL=
AIOPS_TEST_FALSE_ALERT_PROMQL=
AIOPS_TEST_CONFLICT_PROMQL=
AIOPS_TEST_CONFLICT_ELASTIC_QUERY=
AIOPS_TEST_MISSING_TELEMETRY_PROMQL=
AIOPS_TEST_MCP_TIMEOUT_PROMQL=
AIOPS_TEST_LLM_TIMEOUT_PROMQL=
AIOPS_TEST_LLM_OUTPUT_PROMQL=
AIOPS_TEST_REMEDIATION_FAILURE_PROMQL=
AIOPS_TEST_VERIFICATION_FAILURE_PROMQL=
AIOPS_TEST_APPROVAL_PROMQL=
AIOPS_TEST_DUPLICATE_SIGNAL_PROMQL=
AIOPS_TEST_REPEATED_INCIDENT_PROMQL=
AIOPS_TEST_CONCURRENT_INCIDENTS_PROMQL=
