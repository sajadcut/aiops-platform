# SSH-free vmmcpagent settings (copy to /data/aiopsvmagent/agent.env).
# IMPORTANT: agent.env holds production secrets; chmod 0600, never commit.
# Installed agent root: /data/aiopsvmagent/ (binary and configuration).
# All other non-secret platform defaults come from the bundled .env.example.
APP_ENV=production
MCP_SERVER_PROVIDER=vm_agent
MCP_SERVER_REQUIRE_AUTH=True
SSH_ENABLED=False
# Puppet-style: Agent connects OUT to AIOps API (no incoming VM port).
VM_AGENT_CONNECTION_MODE=outbound
VM_AGENT_CONTROL_PLANE_WS_URL=wss://aiops.example.internal/api/v1/vm-agents/connect
VM_AGENT_CA_BUNDLE_PATH=
# Disable only for controlled private testing (MITM can steal credentials).
VM_AGENT_TLS_VERIFY=True

# The exact target key must match a VM_AGENT_ENDPOINTS entry in the API.
VM_AGENT_EXEC_USERNAME=aiops-agent
VM_AGENT_TARGET=
# IMPORTANT: set systemd User= to VM_AGENT_EXEC_USERNAME (installer manages it).
# The password is never stored in this file; API provisions over WSS at connection.
# Only named Linux systemd services may be investigated/controlled.
# systemd EnvironmentFile must keep the interior JSON quotes intact.
VM_AGENT_ALLOWED_SERVICES='["nginx","gfpapi"]'
# UNIQUE random secret (>=32 bytes) for THIS host only, configured under
# VM_AGENT_TOKENS[target] on the Control Plane. DO NOT copy MCP_BEARER_TOKEN.
VM_AGENT_BEARER_TOKEN=
MCP_BEARER_TOKEN=

# Listens only on localhost; publish only through an HTTPS reverse proxy.
VM_AGENT_BIND_PORT=9105

# Private candidate storage on THIS server; never shared with another VM.
AIOPS_CONFIG_CANDIDATE_DIRECTORY=/data/aiopsvmagent/config-candidates
# Agent-owned local log directory; install.sh creates it with restricted permissions.
LOG_DIR=/data/aiopsvmagent/logs
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=True
LOG_TEXT_FILE_ENABLED=True
LOG_JSON_FILE_ENABLED=True
LOG_TEXT_FILE=aiopsvmagent.log
LOG_JSON_FILE=aiopsvmagent.json.log
LOG_ROTATION_MODE=size
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_UTC=True
# Optional full-file LLM repair; disabled unless secure trusted LLM configured.
AIOPS_FULL_CONFIG_LLM_ENABLED=False
# For approved config APPLY: inject a different signing seed per VM via
# a host secret manager/systemd credential mechanism, not into git.
# AIOPS_CONFIG_GUARD_ED25519_PRIVATE_KEY=
