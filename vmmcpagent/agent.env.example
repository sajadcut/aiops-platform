# SSH-free vmmcpagent settings (copy to agent.env next to the agent binary).
# IMPORTANT: agent.env holds production secrets; chmod 0600, never commit.
# All other non-secret platform defaults come from the bundled .env.example.
APP_ENV=production
MCP_SERVER_PROVIDER=vm_agent
MCP_SERVER_REQUIRE_AUTH=True
SSH_ENABLED=False

# The exact target key must match a VM_AGENT_ENDPOINTS entry in the API.
VM_AGENT_TARGET=
# Only named Linux systemd services may be investigated/controlled.
VM_AGENT_ALLOWED_SERVICES=["nginx","gfpapi"]
# UNIQUE random secret (>=32 bytes) for THIS host only, configured under
# VM_AGENT_TOKENS[target] on the Control Plane. DO NOT copy MCP_BEARER_TOKEN.
VM_AGENT_BEARER_TOKEN=
MCP_BEARER_TOKEN=

# Listens only on localhost; publish only through an HTTPS reverse proxy.
VM_AGENT_BIND_PORT=9105

# Private candidate storage on THIS server; never shared with another VM.
AIOPS_CONFIG_CANDIDATE_DIRECTORY=/var/lib/vmmcpagent/config-candidates
# Optional full-file LLM repair; disabled unless secure trusted LLM configured.
AIOPS_FULL_CONFIG_LLM_ENABLED=False
# For approved config APPLY: inject a different signing seed per VM via
# a host secret manager/systemd credential mechanism, not into git.
# AIOPS_CONFIG_GUARD_ED25519_PRIVATE_KEY=
