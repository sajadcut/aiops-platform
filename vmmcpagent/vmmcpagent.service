[Unit]
Description=AIOps VM MCP On-host Agent (SSH-free)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiops-agent
Group=aiops-agent
WorkingDirectory=/data/aiopsvmagent
# Root-owned 0600. systemd reads and injects this file before dropping privileges.
EnvironmentFile=/data/aiopsvmagent/agent.env
ExecStart=/data/aiopsvmagent/vmmcpagent
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectHome=true
# Do not set NoNewPrivileges=true: tightly scoped sudo is necessary for
# approved systemctl and the root-owned, hash/signature-checked config guard.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
