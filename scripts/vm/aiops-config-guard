#!/bin/sh
# Root-owned bounded nginx config guard. Requires a narrow sudoers grant for
# this exact binary only, never NOPASSWD for an unrestricted shell.
set -eu
umask 077
action=$1
service=$2
file=$3
expected_source=$4
expected_candidate=$5
if [ "$(id -u)" != 0 ]; then exit 41; fi
if [ "$action" = apply ]; then
  [ "$#" -eq 10 ] || exit 41
else
  [ "$#" -eq 5 ] || exit 41
fi
case "$action:$service:$file" in
  validate:nginx:/etc/nginx/*.conf|apply:nginx:/etc/nginx/*.conf) ;;
  *) exit 41 ;;
esac
case "$file" in *"/../"*|*"/./"*|*" "*|*"	"*|*"
"*) exit 41 ;; esac
for hash in "$expected_source" "$expected_candidate"; do
  case "$hash" in *[!0123456789abcdef]*|"") exit 41 ;; esac
  [ "$(printf '%s' "$hash" | wc -c)" -eq 64 ] || exit 41
done
if [ "$action" = apply ]; then
  approval=$6
  incident=$7
  target=$8
  expires=$9
  signature=$(printf '%s' "${10}")
  case "$approval:$incident:$target:$expires" in *[!a-zA-Z0-9.:-]*|"") exit 41 ;; esac
  # Ed25519 signature is RFC4648 base64, including + / and =.
  # Its exact decoded length is verified below; the SSH command shell-quotes it.
  [ "$(printf '%s' "$signature" | wc -c)" -eq 88 ] || exit 41
  [ "$expires" -ge "$(date +%s)" ] && [ "$expires" -le "$(($(date +%s) + 60))" ] || exit 41
  # Verification uses ONLY an Ed25519 public key. No private signing secret
  # exists on the VM and no secret can leak through process arguments.
  pubkey=/etc/aiops/config-change-verify.pem
  [ -f "$pubkey" ] && [ ! -L "$pubkey" ] || exit 41
  verify_dir=$(mktemp -d /var/tmp/aiops-config-auth.XXXXXXXX) || exit 41
  chmod 700 "$verify_dir"
  trap 'rm -rf -- "$verify_dir"' EXIT HUP INT TERM
  printf 'v1|apply|%s|%s|%s|%s|%s|%s|%s|%s' \
    "$service" "$file" "$expected_source" "$expected_candidate" \
    "$approval" "$incident" "$target" "$expires" > "$verify_dir/message"
  printf '%s' "$signature" | base64 -d > "$verify_dir/signature" || exit 41
  [ "$(stat -c %s "$verify_dir/signature")" -eq 64 ] || exit 41
  openssl pkeyutl -verify -pubin -inkey "$pubkey" -rawin \
    -in "$verify_dir/message" -sigfile "$verify_dir/signature" \
    >/dev/null 2>&1 || exit 41
  rm -rf -- "$verify_dir"
  trap - EXIT HUP INT TERM
fi
[ -f "$file" ] && [ ! -L "$file" ] && [ "$(readlink -f -- "$file")" = "$file" ] || exit 42
[ -x /usr/sbin/nginx ] && command -v unshare >/dev/null && command -v mount >/dev/null &&
  command -v flock >/dev/null && command -v sha256sum >/dev/null || exit 42
[ "$(stat -c %s -- "$file")" -le 262144 ] || exit 42
[ "$(du -sk /etc/nginx | cut -f1)" -le 51200 ] || exit 42
stage=$(mktemp -d /var/tmp/aiops-config-guard.XXXXXXXX) || exit 42
chmod 700 "$stage"
new=""
cleanup() {
  [ -z "$new" ] || rm -f -- "$new"
  rm -rf -- "$stage"
}
trap cleanup EXIT HUP INT TERM
# Candidate bytes arrive only through authenticated SSH stdin, never argv.
cat > "$stage/candidate"
[ "$(stat -c %s "$stage/candidate")" -le 262144 ] || exit 42
[ "$(sha256sum "$stage/candidate" | cut -d ' ' -f1)" = "$expected_candidate" ] || exit 43
if [ "$action" = apply ]; then
  exec 9>/run/lock/aiops-config-guard.lock
  flock -x -w 15 9 || exit 44
  # The signed ticket is single-use even if the patch subsequently rolls
  # back and the original source hash becomes available again.
  claim_dir=/var/lib/aiops/config-claims
  mkdir -p -m 0700 -- "$claim_dir"
  chmod 0700 "$claim_dir"
  case "$approval" in *[!0123456789abcdef-]*|"") exit 41 ;; esac
  [ ! -e "$claim_dir/$approval" ] || exit 44
  ( umask 077; set -C; printf '%s\n' "$incident" > "$claim_dir/$approval" ) || exit 44
fi
[ "$(sha256sum "$file" | cut -d ' ' -f1)" = "$expected_source" ] || exit 45
cp -a -- /etc/nginx "$stage/tree" || exit 46
relative=$(printf '%s' "$file" | sed 's@^/etc/nginx/@@')
[ -f "$stage/tree/$relative" ] && [ ! -L "$stage/tree/$relative" ] || exit 46
cp -- "$stage/candidate" "$stage/tree/$relative"
# A private mount namespace replaces the nginx tree only for the validator.
# Dependencies outside /etc/nginx are read from live paths and must be disclosed.
unshare -m --propagation private -- /bin/sh -c '
  set -eu
  mount --bind "$1" /etc/nginx
  mount -o remount,bind,ro /etc/nginx
  /usr/sbin/nginx -t -c "$2" >/dev/null 2>&1
' guard "$stage/tree" "$file" >/dev/null 2>&1 || exit 47
if [ "$action" = validate ]; then
  printf 'VALIDATED\n'
  exit 0
fi
[ "$(sha256sum "$file" | cut -d ' ' -f1)" = "$expected_source" ] || exit 45
backup_dir=/var/lib/aiops/config-backups
mkdir -p -m 0700 -- "$backup_dir"
chmod 0700 "$backup_dir"
backup=$(mktemp "$backup_dir/backup.XXXXXXXX")
cp -a -- "$file" "$backup"
new=$(mktemp "$(dirname "$file")/.aiops-config.XXXXXXXX")
cp -a -- "$file" "$new"
cat "$stage/candidate" > "$new"
[ "$(sha256sum "$new" | cut -d ' ' -f1)" = "$expected_candidate" ] || exit 43
[ "$(sha256sum "$file" | cut -d ' ' -f1)" = "$expected_source" ] || exit 45
mv -f -- "$new" "$file"
new=""
if /usr/sbin/nginx -t -c "$file" >/dev/null 2>&1 &&
   [ "$(sha256sum "$file" | cut -d ' ' -f1)" = "$expected_candidate" ]; then
  printf 'APPLIED_VERIFIED\n'
  exit 0
fi
new=$(mktemp "$(dirname "$file")/.aiops-rollback.XXXXXXXX")
cp -a -- "$backup" "$new"
mv -f -- "$new" "$file"
new=""
if [ "$(sha256sum "$file" | cut -d ' ' -f1)" = "$expected_source" ]; then
  printf 'ROLLED_BACK\n'
  exit 48
fi
printf 'ROLLBACK_FAILED\n'
exit 49
