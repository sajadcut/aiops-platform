VM_MCP_SERVER_HOST=0.0.0.0
VM_MCP_SERVER_PORT=8765
VM_MCP_SERVER_INVENTORY_PATH=mcp_servers/vm_management/inventory.yml
VM_MCP_SERVER_REQUIRE_AUTH=true
VM_MCP_SERVER_READ_TOKEN=replace-with-read-token
VM_MCP_SERVER_WRITE_TOKEN=replace-with-distinct-write-token
VM_MCP_SERVER_WRITE_ENABLED=false
VM_MCP_SERVER_SSH_CONNECT_TIMEOUT=10
VM_MCP_SERVER_SSH_COMMAND_TIMEOUT=30
VM_MCP_SERVER_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
VM_MCP_SERVER_SSH_STRICT_HOST_KEY_CHECKING=true
VM_MCP_SERVER_MAX_CONCURRENCY=10
VM_MCP_SERVER_SESSION_TTL_SECONDS=900

# Inventory credential_ref points at an environment variable containing a key path.
VM_HAPROXY_LAB_01_SSH_KEY=/run/secrets/haproxy_lab_01_key
